# don't fail sbt launch when sbtgen.sc is outdated
-Dsbtgen.modificationError=false

# Change coursier settings to speed-up Intellij imports
# - Do not re-check snapshots & publishLocal libraries
-Dcoursier.ttl=14d
-Dcoursier.mode=missing

# todo: disabled, who even used this at least once ?
# -Dsbt.traces=true

# sbt info
-Dsbt.task.timings=true
-Dsbt.task.timings.unit=ms
-Dsbt.task.timings.threshold=300

# toggle for Izumi macro debug output, .rtti=LightTypeTag,TagMacro, .functoid=Functoid, .distage.constructors=AnyConstructor,etc.
# all izumi java properties are in DebugProperties
-Dizumi.debug.macro.rtti=false
-Dizumi.debug.macro.distage.constructors=false
-Dizumi.debug.macro.distage.functoid=false

# toggle for additional runtime sanity checks
-Dizumi.distage.debug.verify-all=false

# toggle for unset axis warn logging
-Dizumi.distage.roles.activation.warn-unset=false

# toggle for distage-testkit debug prints
-Dizumi.distage.testkit.debug=false

# Bumping JIT inline-level increases performance of Scala code
#   https://www.reddit.com/r/scala/comments/cigh0t/these_go_to_eighteen_c_jon_pretty/
#   https://scalacenter.github.io/bloop/docs/performance-guide#tweak-the-java-jit
#   https://twitter.com/leifwickland/status/1179419045055086595
-XX:MaxInlineLevel=18
# These seem to cause sbt import slowdown :\
#-XX:MaxInlineSize=270
#-XX:MaxTrivialSize=12

# please leave at least 12Gb here, it's necessary for machines with large amount of cores
-Xmx12G
# please leave at least 4Gb here, it's necessary for machines with large amount of cores
-XX:MaxMetaspaceSize=4G

-Xss2M
-Xms20M
-XX:+UseG1GC
-XX:ReservedCodeCacheSize=256m
-server
-XX:+OmitStackTraceInFastThrow
-Dsun.io.useCanonCaches=false
-XX:SoftRefLRUPolicyMSPerMB=50


# graalvm
-XX:+UnlockExperimentalVMOptions
-XX:+EnableJVMCI
--enable-native-access=ALL-UNNAMED
-Dpolyglotimpl.AttachLibraryFailureAction=ignore
